{
  "hosting": {
    "public": "www",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|css|js|json)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(png|jpg|jpeg|svg|webp|ico)", "headers": [ { "key": "Cache-Control", "value": "max-age=604800" } ] }
    ]
  },
  "functions": { "source": "functions" },
  "firestore": { "rules": "firestore.rules" }
}
